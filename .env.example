# Local host access to Kafka. Containers use kafka:9092 in Docker Compose.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_RESERVATION_TOPIC=reservation.events.v1_2
KAFKA_GROUP_ID=buenavista-validation-consumer
KAFKA_NEON_GROUP_ID=buenavista-neon-ledger

# Optional Neon sink: use a secret from Neon; never commit a real connection URL.
# Apply migrations/001_create_reservation_event_ledger.sql through the approved process first.
NEON_DATABASE_URL=
