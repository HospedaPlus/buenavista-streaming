# Local Kafka development settings.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RESERVATION_TOPIC=reservation.events.v1_3
KAFKA_GROUP_ID=buenavista-validation-consumer
KAFKA_NEON_GROUP_ID=buenavista-neon-ledger
KAFKA_DLQ_TOPIC=reservation.events.dlq

# Optional Neon sink: use a secret from Neon; never commit a real connection URL.
# Apply migrations/001_create_reservation_event_ledger.sql through the approved process first.
NEON_DATABASE_URL=
# true: each new event is also applied to F3 (schema operation). false: ledger only.
NEON_APPLY_OPERATION=true

# Solo para docker compose: usuario dueño (hospedaplus_owner) que aplica migrations/*.sql.
# El consumidor NUNCA usa este usuario.
NEON_OWNER_URL=

# Stream pace. Requirement: >= 10 events/s at peak. A short peak once an hour keeps
# Neon small (~8,000 events/day). The old 5 ev/s base filled the free tier fast.
F2_BASE_RATE=0.05
F2_PEAK_RATE=15
F2_PEAK_EVERY_S=3600
F2_PEAK_DURATION_S=10
NEON_CONSUMERS=2
