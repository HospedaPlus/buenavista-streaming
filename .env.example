# Local single-node Kafka (development only; no broker authentication).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=buenavista.reservations.v1
KAFKA_DLQ_TOPIC=buenavista.reservations.dlq.v1
KAFKA_CONSUMER_GROUP=buenavista-bronze-neon-v1

# Point to a local throwaway PostgreSQL instance or the approved Neon connection.
# Do not commit credentials. Apply sql/streaming_schema.sql before starting the consumer.
DATABASE_URL=

# Empty bucket writes to local .data/bronze. Set the approved bucket for AWS S3 Bronze.
BRONZE_S3_BUCKET=
BRONZE_S3_PREFIX=bronze/source=f2_channel_manager
BRONZE_LOCAL_DIR=.data/bronze
