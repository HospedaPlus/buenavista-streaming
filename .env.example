# Local development Kafka broker (no authentication).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=buenavista.reservations.v1
KAFKA_RETRY_TOPIC=buenavista.reservations.retry.v1
KAFKA_DLQ_TOPIC=buenavista.reservations.dlq.v1
KAFKA_NEON_GROUP=buenavista-neon-projector-v1
KAFKA_BRONZE_GROUP=buenavista-bronze-capture-v1
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_DELAY_SECONDS=5

# F2-specific additive Neon schema, applied through approved migrations.
DATABASE_URL=

# Empty bucket writes under .data/bronze; S3 uses the AWS credential chain.
BRONZE_S3_BUCKET=
BRONZE_S3_PREFIX=bronze/source=f2_channel_manager
BRONZE_LOCAL_DIR=.data/bronze
BRONZE_BATCH_SIZE=500
BRONZE_BATCH_TIMEOUT_SECONDS=30
