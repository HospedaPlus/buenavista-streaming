# Local RabbitMQ settings. These defaults are for development only.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=buenavista.reservation.events
# Topic exchange for F2 events; routing key = event type, e.g. reservation.cancelled.
RABBITMQ_EXCHANGE=buenavista.reservations
# Retry policy for transient reservation-event processing failures.
# Retry attempts are limited to prevent messages from looping indefinitely.
RABBITMQ_MAX_RETRIES=3

# Delay before retrying a message that failed due to a temporary error.
# The value is expressed in milliseconds.
RABBITMQ_RETRY_DELAY_MS=10000

# Queue used to retain invalid or repeatedly failing messages for inspection.
RABBITMQ_DLQ=buenavista.reservation.events.dlq
