# Local Kafka development settings.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RESERVATION_TOPIC=reservation.events.v1_3
KAFKA_GROUP_ID=buenavista-validation-consumer
KAFKA_NEON_GROUP_ID=buenavista-neon-ledger
KAFKA_DLQ_TOPIC=reservation.events.dlq

# S3 Bronze landing consumer (src/bronze_consumer.py).
KAFKA_BRONZE_GROUP_ID=hospedaplus-bronze-s3
BRONZE_BUCKET=
BRONZE_PREFIX=bronze/f2_reservation_events
BRONZE_FLUSH_SECONDS=300
BRONZE_MAX_BATCH=5000
# Optional: KMS key ARN or alias for server-side encryption.
BRONZE_KMS_KEY_ID=
# AWS credentials come from the AWS CLI profile or the ECS task role; never put keys here.

# Optional Neon sink: use a secret from Neon; never commit a real connection URL.
# Apply migrations/001_create_reservation_event_ledger.sql through the approved process first.
NEON_DATABASE_URL=
