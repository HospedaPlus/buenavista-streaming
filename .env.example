# Local development defaults for LocalStack; these are dummy credentials only.
AWS_REGION=us-east-1

# LocalStack does not authenticate these sample credentials.
# Never put production credentials in this tracked example file.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Route boto3 to LocalStack. Unset this variable for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# Stream settings used by the producer.
KINESIS_STREAM_NAME=buenavista-reservation-events
KINESIS_SHARD_COUNT=1
